# Contoh file .env untuk development
# Copy file ini menjadi .env dan isi dengan data Anda sendiri

# ============================================
# DATABASE - Neon PostgreSQL
# ============================================
# Dapatkan dari https://neon.tech setelah membuat project

# Pooled connection - untuk aplikasi Next.js
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection - untuk Prisma migrations
DIRECT_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ============================================
# NEXTAUTH - Authentication
# ============================================

# URL aplikasi Anda
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secret key untuk enkripsi session
# Generate dengan: openssl rand -base64 32
# Atau: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-generated-secret-key-min-32-characters"

# ============================================
# GOOGLE OAUTH (Optional - bisa dikosongkan)
# ============================================
# Dapatkan dari: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# TIPS & NOTES
# ============================================

# 1. Jangan commit file .env ke Git!
# 2. Gunakan .env.example sebagai template
# 3. Setiap developer butuh .env sendiri
# 4. Production env variables diset di Vercel dashboard
# 5. Restart dev server setelah ubah .env
